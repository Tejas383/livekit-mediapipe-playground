# Copy to .env.local (gitignored) and fill in.
# NEVER put LIVEKIT_API_SECRET here — every VITE_ variable is bundled into the frontend.

# LiveKit Cloud project URL (Project Settings in the LiveKit Cloud dashboard)
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# Option A: a token generated with the CLI, e.g.
#   lk token create --join --room playground --identity alice --valid-for 24h
VITE_LIVEKIT_TOKEN=

# Option B: LiveKit Cloud sandbox token server ID (dev only)
VITE_LIVEKIT_SANDBOX_ID=
